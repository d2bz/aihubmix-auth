{
  "id": "aihubmix-auth",
  "name": "AIHubmix",
  "description": "Route OpenAI/Anthropic/Gemini model calls through AIHubmix",
  "version": "2026.2.21",
  "providers": [
    "aihubmix-openai",
    "aihubmix-anthropic",
    "aihubmix-google",
    "aihubmix-other"
  ],
  "modelSupport": {
    "modelPrefixes": ["aihubmix-"]
  },
  "setup": {
    "providers": [
      {
        "id": "aihubmix-openai",
        "authMethods": ["api-key"],
        "envVars": ["AIHUBMIX_API_KEY"]
      },
      {
        "id": "aihubmix-anthropic",
        "authMethods": ["api-key"],
        "envVars": ["AIHUBMIX_API_KEY"]
      },
      {
        "id": "aihubmix-google",
        "authMethods": ["api-key"],
        "envVars": ["AIHUBMIX_API_KEY"]
      },
      {
        "id": "aihubmix-other",
        "authMethods": ["api-key"],
        "envVars": ["AIHUBMIX_API_KEY"]
      }
    ],
    "requiresRuntime": true
  },
  "providerAuthAliases": {
    "aihubmix-anthropic": "aihubmix-openai",
    "aihubmix-google": "aihubmix-openai",
    "aihubmix-other": "aihubmix-openai"
  },
  "providerAuthChoices": [
    {
      "provider": "aihubmix-openai",
      "method": "api-key",
      "choiceId": "aihubmix-api-key-openai",
      "choiceLabel": "AIHubmix OpenAI key",
      "choiceHint": "Paste one AIHubmix key shared across all four transports",
      "groupId": "aihubmix",
      "groupLabel": "AIHubmix",
      "optionKey": "aihubmixApiKeyOpenai",
      "cliFlag": "--aihubmix-api-key",
      "cliOption": "--aihubmix-api-key <key>",
      "cliDescription": "AIHubmix API key (shared across OpenAI/Anthropic/Gemini/Other transports)",
      "onboardingScopes": ["text-inference"]
    }
  ],
  "activation": {
    "onStartup": false,
    "onProviders": [
      "aihubmix-openai",
      "aihubmix-anthropic",
      "aihubmix-google",
      "aihubmix-other"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  }
}
