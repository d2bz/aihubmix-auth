{
  "name": "@akaknele/aihubmix-auth",
  "version": "2026.2.20",
  "description": "OpenClaw AIHubmix API provider plugin",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./openclaw.plugin.json": "./openclaw.plugin.json"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "openclaw": "^2026.6.6",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "peerDependencies": {
    "openclaw": ">=2026.5.27"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.5.27"
    },
    "install": {
      "npmSpec": "@akaknele/aihubmix-auth@2026.2.20",
      "minHostVersion": ">=2026.5.27"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akakenle/aihubmix-auth.git"
  },
  "bugs": {
    "url": "https://github.com/akakenle/aihubmix-auth/issues"
  },
  "homepage": "https://github.com/akakenle/aihubmix-auth#readme"
}
